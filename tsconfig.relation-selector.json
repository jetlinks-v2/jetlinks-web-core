{
  "compilerOptions": {
    "target": "ESNext", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "jsx": "preserve", "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "baseUrl": ".", "paths": { "@jetlinks-web-core/*": ["src/*"] },
    "types": ["vite/client", "ant-design-vue/typings/global"], "noEmit": true
  },
  "include": ["src/components/RelationSelector/**/*", "src/views/relation-selector/**/*", "src/api/relations.ts", "src/env.d.ts"]
}
