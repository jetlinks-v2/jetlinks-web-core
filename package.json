{
  "name": "jetlinks-ui-core",
  "private": true,
  "version": "2.12.0",
  "scripts": {
    "dev": "vite",
    "dev:force": "vite --force",
    "build": "node --max_old_space_size=1024000 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "clean": "pnpm rimraf node_modules && pnpm rimraf dist && pnpm rimraf .turbo",
    "modules:init": "gitmodules.sh && update:tsconfig",
    "modules:update": "git submodule update",
    "test": "playwright test",
    "build:server": "pnpm build --mode server",
    "build:modules": "pnpm build -- --module-name",
    "update:tsconfig": "node ./configs/plugin/tsconfig.ts"
  },
  "dependencies": {
    "xgplayer": "^3.0.21",
    "xgplayer-flv": "^3.0.21",
    "xgplayer-hls": "^3.0.21"
  },
  "devDependencies": {
  },
  "volta": {
    "node": "22.18.0",
    "yarn": "1.22.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
